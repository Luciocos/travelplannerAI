# Copiar este archivo a .env y completar los valores. .env nunca se versiona.

# --- LLM (Gemini) ---
LLM_PROVIDER=gemini
# Confirmado 2026-09-10 contra la API real: gemini-2.5-flash-lite ya no esta
# disponible para estas claves ("no longer available to new users"), Google
# redirige a gemini-3.5-flash-lite. Ver D-03 en DECISIONES.md.
GEMINI_MODEL=gemini-3.5-flash-lite

# Rotacion de 3 claves. Agregar GEMINI_API_KEY_4, _5, etc. si hace falta mas adelante,
# config.py las detecta automaticamente sin cambios de codigo.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# --- Datos ---
OPENTRIPMAP_API_KEY=

# --- RapidAPI (extensiones RF6/RF7). Amadeus self-service se dio de baja en
# julio 2026 (ver docs/DECISIONES.md D-05/D-06). Booking.com15 para hoteles,
# Fly Scraper para vuelos, ambas con plan Free y auth por headers. Una sola
# key de cuenta sirve para las dos, cambia el host segun la API. ---
RAPIDAPI_KEY=
RAPIDAPI_HOST_BOOKING=booking-com15.p.rapidapi.com
RAPIDAPI_HOST_FLY_SCRAPER=fly-scraper.p.rapidapi.com
# Presupuesto de llamadas del plan Free, para el guard de cuota.
RAPIDAPI_MONTHLY_QUOTA_BOOKING=100
RAPIDAPI_MONTHLY_QUOTA_FLY_SCRAPER=100
# Si es true, no sale a la red: sirve todo desde services/rapidapi/fixtures/.
USE_FIXTURES=false

# --- Base de datos ---
# Local (docker-compose): postgresql://postgres:postgres@localhost:5432/asistente_viajes
# Supabase: usar la connection string del panel del proyecto (modo "session" o "transaction pooler")
DATABASE_URL=